{
  "name": "trendsetter",
  "compatibility_date": "2024-01-01",
  "pages": {
    "build_command": "npm run build",
    "build_output_dir": ".next",
    "routes": [
      {
        "pattern": "track.costinghub.com",
        "zone_name": "costinghub.com"
      }
    ]
  },
  "vars": {
    "NEXT_PUBLIC_APP_NAME": "Trendsetter",
    "NEXT_PUBLIC_APP_URL": "https://track.costinghub.com"
  }
}
